#!/usr/bin/env bash
# Baseline measurement snapshot for autoresearch.
# Prints experiments/hour, best val_bpb, and iteration count since branch start.
set -euo pipefail

TSV="${1:-results.tsv}"

if [[ ! -f "$TSV" ]]; then
  echo "no $TSV yet"
  exit 0
fi

# Skip header; count non-crash rows
total=$(tail -n +2 "$TSV" | wc -l | tr -d ' ')
kept=$(awk -F'\t' 'NR>1 && $4=="keep"' "$TSV" | wc -l | tr -d ' ')
crashed=$(awk -F'\t' 'NR>1 && $4=="crash"' "$TSV" | wc -l | tr -d ' ')
best=$(awk -F'\t' 'NR>1 && $4!="crash" && ($2+0)>0 {print $2}' "$TSV" | sort -n | head -1)

# Experiments/hour since branch creation
branch=$(git rev-parse --abbrev-ref HEAD)
branch_start=$(git log --reverse --format=%ct "$branch" 2>/dev/null | head -1)
now=$(date +%s)
if [[ -n "$branch_start" && "$total" -gt 0 ]]; then
  hours=$(awk -v s="$branch_start" -v n="$now" 'BEGIN{printf "%.2f",(n-s)/3600}')
  rate=$(awk -v t="$total" -v h="$hours" 'BEGIN{if(h>0)printf "%.1f",t/h; else print "n/a"}')
else
  hours="n/a"
  rate="n/a"
fi

cat <<EOF
branch:         $branch
iterations:     $total (kept=$kept, crashed=$crashed)
best_val_bpb:   ${best:-n/a}
hours_elapsed:  $hours
experiments/h:  $rate
EOF
